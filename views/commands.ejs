<!DOCTYPE html>
<html>
<head>
  <title>Ananas Music Bot Commands</title>
  <style>
     body {
      font-family: sans-serif;
      margin: 0;
      padding: 20px;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    h1, h2 {
      text-align: center;
      margin-bottom: 20px;
      font-weight: normal;
    }

    h1 {
      font-size: 2em;
    }

    table {
      border-collapse: collapse;
      width: 80%;
      margin: 0 auto;
      text-align: left;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    th, td {
      padding: 10px;
      border: 1px solid #ddd;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    th {
      background-color: #f2f2f2;
    }

    tr:nth-child(even) {
      background-color: #f7f7f7;
    }

    .general-commands, .mod-commands {
      margin-top: 40px;
    }

    /* Light mode styles */
    .light {
      background-color: #fff;
      color: #000;
    }

    /* Dark mode styles */
    .dark {
      background-color: #222;
      color: #fff;
    }

    /* Media query for Chromium's dark mode preference */
    @media (prefers-color-scheme: dark) {
      body {
        @media (prefers-color-scheme: no-preference) {
          /* Handle case where user's preference is "no-preference" */
          .light {
            display: none; /* Hide light styles when user has no preference and Chromium is in dark mode */
          }
        }
      }
    }

    /* Additional styles for consistency */
    table.light, table.dark {
      background-color: inherit; /* Inherit background color from body */
    }

    th.light, th.dark, td.light, td.dark {
      background-color: inherit; /* Inherit background color from body */
      color: inherit; /* Inherit color from body */
    }

    th.light, th.dark {
      background-color: #333; /* Adjust header background color slightly */
    }

    tr.light:nth-child(even), tr.dark:nth-child(even) {
      background-color: #444; /* Adjust even row background color slightly */
    }
  </style>
</head>
<body>
  <h1>Commands</h1>
  <h2 class="general-commands"><u>General Commands</u></h2>
  <table class="general-commands">
    <tr>
      <th>Command</th>
      <th>Description</th>
    </tr>
    <tr>
      <td>!song</td>
      <td>Get the currently playing song</td>
    </tr>
    <tr>
      <td>!queue / !q [optional: number between 1 - 10, how many items to return]</td>
      <td>Get next 5 songs</td>
    </tr>
    <tr>
      <td>!rqueue /!rq [optional: number between 1 - 10, how many items to return]</td>
      <td>Get previous 5 songs</td>
    </tr>
    <tr>
      <td>!playlist</td>
      <td>Get the currently active playlist/artist/album</td>
    </tr>
    <tr>
      <td>!maxlength</td>
      <td>Check how long a song is allowed to be</td>
    </tr>
  </table>
  <h2 class="mod-commands"><u>Mod Commands</u></h2>
  <table class="mod-commands">
    <tr>
      <th>Command</th>
      <th>Description</th>
    </tr>
    <tr>
      <td>!queue [spotify link/search query]</td>
      <td>Add song to queue</td>
    </tr>
    <tr>
      <td>!play</td>
      <td>Resume playing</td>
    </tr>
    <tr>
      <td>!resume</td>
      <td>Resume playing</td>
    </tr>
    <tr>
      <td>!pause</td>
      <td>Pause currently playing song</td>
    </tr>
    <tr>
      <td>!play [spotify link/search query]</td>
      <td>Play song instantly, skip queue</td>
    </tr>
    <tr>
      <td>!volume [percentage]</td>
      <td>Set volume to specific volume</td>
    </tr>
    <tr>
      <td>!skip</td>
      <td>Skip to next song</td>
    </tr>
    <tr>
      <td>!skipback / !previous</td>
      <td>Skip back to previous song</td>
    </tr>
    <tr>
      <td>!bluser [twitch username]</td>
      <td>Blacklist user from requesting songs</td>
    </tr>
    <tr>
      <td>!blusers</td>
      <td>Get all currently blacklisted users</td>
    </tr>
    <tr>
      <td>!bltrack [spotify track link]</td>
      <td>Blacklist song from being requested</td>
    </tr>
    <tr>
      <td>!blartist [spotify artist link]</td>
      <td>Blacklist artist from being requested</td>
    </tr>
    <tr>
      <td>!wluser [twitch username]</td>
      <td>Remove user from blacklist</td>
    </tr>
    <tr>
      <td>!wltrack [spotify track link]</td>
      <td>Remove song from blacklist</td>
    </tr>
    <tr>
      <td>!wlartist [spotify artist link]</td>
      <td>Remove artist from blacklist</td>
    </tr>
    <tr>
      <td>!maxlength [amount of seconds allowed]</td>
      <td>Set how long a song is allowed to be in seconds</td>
    </tr>
  </table>
</body>
</html>